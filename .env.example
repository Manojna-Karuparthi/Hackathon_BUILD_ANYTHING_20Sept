# Copy to .env and edit. EVERY value here is optional — the system runs with none.

# ---- data sources -------------------------------------------------------
# auto   : try live feeds, fall back to scenario replay if unreachable (default)
# live   : live feeds only
# replay : bundled scenarios only — guaranteed offline, use this on stage
PRAHARI_SOURCE_MODE=auto

# ---- prediction ---------------------------------------------------------
# Probability at or above which a FORECAST raises an alarm on its own, without
# waiting for current conditions to cross a threshold. This is the number that
# buys evacuation time, so it is a setting rather than a buried constant.
# PRAHARI_ALARM_PROBABILITY=0.90
# PRAHARI_FORECAST_HORIZON_H=24

# ---- Hugging Face (optional) -------------------------------------------
# Without a token the incident corpus still loads locally, the assistant still
# answers in every language, and explanations still render from the rules
# engine. The token only adds LLM phrasing for free-form questions.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# PRAHARI_HF_DATASET=your-username/geohazard-incidents
# PRAHARI_HF_BRIEFING_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- generic webhook (optional) -----------------------------------------
# POST every alert — with all translations attached — to an existing emergency
# operations system, PA controller or SMS gateway.
# PRAHARI_WEBHOOK_URL=https://example.org/hooks/prahari

# ---- tuning (optional) --------------------------------------------------
# PRAHARI_PORT=8000
# PRAHARI_BAND_WARNING=70
# PRAHARI_FUSION_KAPPA=0.35
# PRAHARI_GEO_RADIUS_KM=120

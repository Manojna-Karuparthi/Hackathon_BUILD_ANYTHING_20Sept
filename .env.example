# Copy to .env and edit. EVERY value here is optional — the system runs with none.

# ---- data sources -------------------------------------------------------
# auto   : try live feeds, fall back to scenario replay if unreachable (default)
# live   : live feeds only
# replay : bundled scenarios only — guaranteed offline, use this on stage
PRAHARI_SOURCE_MODE=auto

# ---- Hugging Face (optional) -------------------------------------------
# Without a token the corpus still loads locally and explanations still render
# from the deterministic rules engine. The token only adds LLM phrasing.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# PRAHARI_HF_DATASET=your-username/geohazard-incidents
# PRAHARI_HF_BRIEFING_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- WhatsApp bonus channel (optional) ----------------------------------
# Twilio sandbox. The demo does NOT depend on this — the browser siren and
# speech channel is the primary path precisely because it has no dependency.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ---- generic webhook (optional) -----------------------------------------
# POST every alert to an existing emergency-operations system.
# PRAHARI_WEBHOOK_URL=https://example.org/hooks/prahari

# ---- tuning (optional) --------------------------------------------------
# PRAHARI_PORT=8000
# PRAHARI_BAND_WARNING=70
# PRAHARI_FUSION_KAPPA=0.35
